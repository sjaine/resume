
# Admin login (stage B). Use a long password; nobody types it but you.
ADMIN_PASSWORD=
# Any long random string. Generate one with:  openssl rand -hex 32
SESSION_SECRET=

# Storage (stage C). Leave empty locally: drafts are saved in the .data folder instead.
# On Vercel: Storage → Create → Blob (Private) → connect to this project; this variable is added for you.
BLOB_READ_WRITE_TOKEN=